# Copy to .env on the machine that runs VaultBridge.
VAULTBRIDGE_HOST=0.0.0.0
VAULTBRIDGE_PORT=8728
VAULTBRIDGE_DATA_DIR=./data

# Optional. If omitted, VaultBridge creates ./data/secret.key locally.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BACKUP_SECRET_KEY=


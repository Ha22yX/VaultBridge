VAULTBRIDGE_HOST=0.0.0.0
VAULTBRIDGE_PORT=8728
VAULTBRIDGE_DATA_DIR=/app/data

# Generate with:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BACKUP_SECRET_KEY=

# Host-side NAS folder mounted into the container as /服务器备份 and /server-backups.
VAULTBRIDGE_BACKUP_HOST_DIR=./backups

# Optional runtime user mapping for NAS systems that require a specific UID/GID.
PUID=0
PGID=0

# Optional rsync tuning.
VAULTBRIDGE_RSYNC_WORKERS=3
VAULTBRIDGE_RSYNC_RETRIES=2
VAULTBRIDGE_RSYNC_RESUME_RETRIES=10
